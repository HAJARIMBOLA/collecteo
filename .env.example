DB_URL=jdbc:postgresql://<host>:<port>/<database>?sslmode=require
DB_USERNAME=<utilisateur>
DB_PASSWORD=<mot_de_passe>

# Optionnel — surcharge le secret JWT par défaut (fortement recommandé en prod)
JWT_SECRET=<une_chaine_aleatoire_d_au_moins_32_caracteres>

# Optionnel — active les logs SQL verbeux en dev si besoin
# JPA_SHOW_SQL=true
# HIBERNATE_SQL_LOG_LEVEL=debug